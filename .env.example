EMAIL_ADDRESS=
# Opcional: key de OpenAlex (gratis, https://openalex.org/users/me). Sin ella el
# presupuesto diario se comparte por IP y se agota (HTTP 429). fetch_papers.py
# la envía sola si existe.
OPENALEX_API_KEY=
SCIENCEDIRECT_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SCOPUS_API_KEY=

# NVIDIA (build.nvidia.com, plan gratis). NVIDIA_API_KEY: Nemotron, que aclara el tema,
# genera las cadenas de búsqueda y arma las fichas de los papers.
# NVIDIA_PARSE_API_KEY: Nemotron Parse, que lee las tablas y los PDFs que el lector
# local no entiende. Son dos keys distintas (una por modelo).
NVIDIA_API_KEY=
NVIDIA_PARSE_API_KEY=
